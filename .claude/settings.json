{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(shasum -a 256)",
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(supabase gen types *)",
      "Bash(supabase migration list*)"
    ],
    "ask": [
      "Bash(bun run db:push*)",
      "Bash(bun run db:migrate*)",
      "Bash(supabase db push*)",
      "Bash(supabase db reset*)",
      "Bash(supabase migration repair*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify.sh",
            "timeout": 180,
            "statusMessage": "型チェックとテストを実行中"
          }
        ]
      }
    ]
  },
  "language": "japanese"
}
